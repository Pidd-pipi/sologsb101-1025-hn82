{
  "name": "gbroastlog-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "咖啡烘焙曲线与杯测档案 - 纯前端 SPA（React + TypeScript + Ant Design + Vite + Redux Toolkit + React Router + Dexie）",
  "scripts": {
    "dev": "vite --host --port 22825",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 22825",
    "typecheck": "tsc --noEmit",
    "test:merge": "esbuild scripts/test-merge.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-merge.mjs && node node_modules/.cache/test-merge.mjs",
    "test:merge:db": "esbuild scripts/test-merge-db.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-merge-db.mjs && node node_modules/.cache/test-merge-db.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
